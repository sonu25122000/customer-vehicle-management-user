# Backend API URL for local dev only — points the Vite dev-server proxy (see vite.config.js) at
# the backend. The app itself always calls the same-origin '/api' path (src/api/client.js).
# In production, the equivalent target lives in vercel.json's rewrites instead.
VITE_API_BASE_URL=http://localhost:5000/api

# WhatsApp number for "WhatsApp Us" — digits only, with country code, no + (e.g. 919876543210).
# Leave empty and the button opens WhatsApp's contact picker with the message pre-filled instead.
VITE_WHATSAPP_NUMBER=

# The number to call — shown in the header (call button), hero, contact section and footer. Defaults
# to the WhatsApp number above (without the 91) when empty.
VITE_SUPPORT_PHONE=
VITE_SUPPORT_EMAIL=

# Online booking ("Book a Car"). Hidden unless true — must match ENABLE_PORTAL_BOOKING on the backend.
# VITE_ENABLE_BOOKING=false

# Instagram profile promoted on the home page and footer.
VITE_INSTAGRAM_URL=https://www.instagram.com/roam_wheels

# Google Analytics: the Google tag (G-XJFYTYEP97) is in index.html — nothing to set here.

# The website's public address, used for sitemap.xml (generated before every build — npm run sitemap).
# Also update the Sitemap line in public/robots.txt if this changes.
SITE_URL=https://customer-vehicle-management-user.vercel.app
